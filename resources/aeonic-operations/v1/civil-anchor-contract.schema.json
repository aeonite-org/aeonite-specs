{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeonic-operations:temporal:civil-anchor:contract:v1:working",
  "title": "Aeonic single-day civil anchoring working contract",
  "description": "Closed requests and results. Exact translation, Gregorian validity, canonical sets, explicit selection, admission and diagnostic precedence additionally require the normative source. Reused definitions are local projections of the three frozen snapshot0.1 schemas; this profile extends only its own deferred category vocabulary.",
  "$ref": "#/$defs/request",
  "$defs": {
    "date_deferredBundle": {
      "type": "object",
      "properties": {
        "temporal": {
          "$ref": "#/$defs/date_deferred"
        },
        "originGranularity": {
          "enum": [
            "day",
            "month",
            "year",
            "undeclared"
          ]
        },
        "history": {
          "enum": [
            "none-declared",
            "clamping-declared"
          ]
        }
      },
      "required": [
        "temporal"
      ],
      "additionalProperties": false
    },
    "date_deferred": {
      "type": "object",
      "properties": {
        "category": {
          "enum": [
            "civilClock",
            "civilClockSet",
            "civilDateTime",
            "civilDateTimeSet",
            "finiteNumber",
            "exactNumber",
            "exactRational",
            "string",
            "boolean",
            "symbol",
            "positiveInfinity",
            "negativeInfinity",
            "nan",
            "explicitNull",
            "explicitAbsence",
            "toggle",
            "hex",
            "radix",
            "encoding",
            "separator",
            "sansaAddress",
            "referenceForm",
            "temporal",
            "container"
          ]
        }
      },
      "required": [
        "category"
      ],
      "additionalProperties": true
    },
    "date_derivedBundle": {
      "type": "object",
      "properties": {
        "temporal": {
          "$ref": "#/$defs/date_civilDateSet"
        },
        "originGranularity": {
          "enum": [
            "day",
            "month",
            "year",
            "undeclared"
          ]
        },
        "history": {
          "enum": [
            "none-declared",
            "clamping-declared"
          ]
        }
      },
      "required": [
        "temporal",
        "originGranularity",
        "history"
      ],
      "additionalProperties": false
    },
    "date_civilDateSet": {
      "type": "object",
      "properties": {
        "category": {
          "const": "civilDateSet"
        },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/date_range"
          }
        }
      },
      "required": [
        "category",
        "ranges"
      ],
      "additionalProperties": false
    },
    "date_range": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
        },
        "end": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "date_authoredBundle": {
      "type": "object",
      "properties": {
        "temporal": {
          "$ref": "#/$defs/date_civilDate"
        },
        "originGranularity": {
          "enum": [
            "day",
            "month",
            "year",
            "undeclared"
          ]
        },
        "history": {
          "enum": [
            "none-declared",
            "clamping-declared"
          ]
        }
      },
      "required": [
        "temporal"
      ],
      "additionalProperties": false
    },
    "date_civilDate": {
      "type": "object",
      "properties": {
        "category": {
          "const": "civilDate"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9]{4}-(?:[0-9]{2}(?:-[0-9]{2})?)?$(?![\\s\\S])"
        }
      },
      "required": [
        "category",
        "value"
      ],
      "additionalProperties": false
    },
    "clock_deferredBundle": {
      "type": "object",
      "properties": {
        "temporal": {
          "$ref": "#/$defs/clock_deferredTemporal"
        },
        "originClockForm": {
          "$ref": "#/$defs/clock_clockOrigin"
        },
        "history": {
          "$ref": "#/$defs/clock_history"
        }
      },
      "required": [
        "temporal"
      ],
      "additionalProperties": false
    },
    "clock_history": {
      "enum": [
        "none-declared",
        "approximation-declared"
      ]
    },
    "clock_clockOrigin": {
      "enum": [
        "hour",
        "minute",
        "second",
        "undeclared"
      ]
    },
    "clock_deferredTemporal": {
      "type": "object",
      "properties": {
        "category": {
          "enum": [
            "civilDate",
            "civilDateSet",
            "civilDateTime",
            "civilDateTimeSet",
            "finiteNumber",
            "exactNumber",
            "exactRational",
            "string",
            "boolean",
            "symbol",
            "positiveInfinity",
            "negativeInfinity",
            "nan",
            "explicitNull",
            "explicitAbsence",
            "toggle",
            "hex",
            "radix",
            "encoding",
            "separator",
            "sansaAddress",
            "referenceForm",
            "temporal",
            "container"
          ]
        }
      },
      "required": [
        "category"
      ],
      "additionalProperties": true
    },
    "clock_derivedBundle": {
      "type": "object",
      "properties": {
        "temporal": {
          "$ref": "#/$defs/clock_civilClockSet"
        },
        "originClockForm": {
          "$ref": "#/$defs/clock_clockOrigin"
        },
        "history": {
          "$ref": "#/$defs/clock_history"
        }
      },
      "required": [
        "temporal",
        "originClockForm",
        "history"
      ],
      "additionalProperties": false
    },
    "clock_civilClockSet": {
      "type": "object",
      "properties": {
        "category": {
          "const": "civilClockSet"
        },
        "pieces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/clock_piece"
          }
        }
      },
      "required": [
        "category",
        "pieces"
      ],
      "additionalProperties": false
    },
    "clock_piece": {
      "oneOf": [
        {
          "$ref": "#/$defs/clock_point"
        },
        {
          "$ref": "#/$defs/clock_interval"
        }
      ]
    },
    "clock_interval": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "interval"
        },
        "start": {
          "$ref": "#/$defs/clock_coordinate"
        },
        "end": {
          "$ref": "#/$defs/clock_coordinate"
        },
        "includeStart": {
          "type": "boolean"
        },
        "includeEnd": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "start",
        "end",
        "includeStart",
        "includeEnd"
      ],
      "additionalProperties": false
    },
    "clock_coordinate": {
      "type": "object",
      "properties": {
        "day": {
          "$ref": "#/$defs/clock_count"
        },
        "time": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]*[1-9])?$(?![\\s\\S])"
        }
      },
      "required": [
        "day",
        "time"
      ],
      "additionalProperties": false
    },
    "clock_count": {
      "type": "string",
      "pattern": "^(?:0|-?[1-9][0-9]*)$(?![\\s\\S])"
    },
    "clock_point": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "point"
        },
        "at": {
          "$ref": "#/$defs/clock_coordinate"
        }
      },
      "required": [
        "kind",
        "at"
      ],
      "additionalProperties": false
    },
    "clock_authoredBundle": {
      "type": "object",
      "properties": {
        "temporal": {
          "$ref": "#/$defs/clock_civilClock"
        },
        "originClockForm": {
          "$ref": "#/$defs/clock_clockOrigin"
        },
        "history": {
          "$ref": "#/$defs/clock_history"
        }
      },
      "required": [
        "temporal"
      ],
      "additionalProperties": false
    },
    "clock_civilClock": {
      "type": "object",
      "properties": {
        "category": {
          "const": "civilClock"
        },
        "value": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):(?:[0-5][0-9](?::[0-5][0-9](?:\\.[0-9]+)?)?)?$(?![\\s\\S])"
        }
      },
      "required": [
        "category",
        "value"
      ],
      "additionalProperties": false
    },
    "datetime_derivedBundle": {
      "type": "object",
      "properties": {
        "temporal": {
          "$ref": "#/$defs/datetime_civilDateTimeSet"
        },
        "originDateGranularity": {
          "$ref": "#/$defs/datetime_dateOrigin"
        },
        "originClockForm": {
          "$ref": "#/$defs/datetime_clockOrigin"
        },
        "history": {
          "$ref": "#/$defs/datetime_history"
        }
      },
      "required": [
        "temporal",
        "originDateGranularity",
        "originClockForm",
        "history"
      ],
      "additionalProperties": false
    },
    "datetime_history": {
      "type": "object",
      "properties": {
        "clamping": {
          "enum": [
            "none-declared",
            "clamping-declared"
          ]
        },
        "approximation": {
          "enum": [
            "none-declared",
            "approximation-declared"
          ]
        }
      },
      "required": [
        "clamping",
        "approximation"
      ],
      "additionalProperties": false
    },
    "datetime_clockOrigin": {
      "enum": [
        "hour",
        "minute",
        "second",
        "undeclared"
      ]
    },
    "datetime_dateOrigin": {
      "enum": [
        "year",
        "month",
        "day",
        "undeclared"
      ]
    },
    "datetime_civilDateTimeSet": {
      "type": "object",
      "properties": {
        "category": {
          "const": "civilDateTimeSet"
        },
        "pieces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/datetime_piece"
          }
        }
      },
      "required": [
        "category",
        "pieces"
      ],
      "additionalProperties": false
    },
    "datetime_piece": {
      "oneOf": [
        {
          "$ref": "#/$defs/datetime_point"
        },
        {
          "$ref": "#/$defs/datetime_interval"
        }
      ]
    },
    "datetime_interval": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "interval"
        },
        "start": {
          "$ref": "#/$defs/datetime_coordinate"
        },
        "end": {
          "oneOf": [
            {
              "$ref": "#/$defs/datetime_coordinate"
            },
            {
              "$ref": "#/$defs/datetime_endBoundary"
            }
          ]
        },
        "includeStart": {
          "type": "boolean"
        },
        "includeEnd": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "start",
        "end",
        "includeStart",
        "includeEnd"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "end": {
                "type": "object"
              }
            },
            "required": [
              "end"
            ]
          },
          "then": {
            "properties": {
              "includeEnd": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "datetime_endBoundary": {
      "type": "object",
      "properties": {
        "boundary": {
          "const": "endOfDomain"
        }
      },
      "required": [
        "boundary"
      ],
      "additionalProperties": false
    },
    "datetime_coordinate": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]*[1-9])?$(?![\\s\\S])"
    },
    "datetime_point": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "point"
        },
        "at": {
          "$ref": "#/$defs/datetime_coordinate"
        }
      },
      "required": [
        "kind",
        "at"
      ],
      "additionalProperties": false
    },
    "date_bundle": {
      "oneOf": [
        {
          "$ref": "#/$defs/date_authoredBundle"
        },
        {
          "$ref": "#/$defs/date_derivedBundle"
        },
        {
          "$ref": "#/$defs/date_deferredBundle"
        }
      ]
    },
    "clock_bundle": {
      "oneOf": [
        {
          "$ref": "#/$defs/clock_authoredBundle"
        },
        {
          "$ref": "#/$defs/clock_derivedBundle"
        },
        {
          "$ref": "#/$defs/clock_deferredBundle"
        }
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$(?![\\s\\S])",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "operation": {
          "const": "anchor"
        },
        "input": {
          "type": "object",
          "properties": {
            "anchor": {
              "$ref": "#/$defs/date_bundle"
            },
            "clock": {
              "$ref": "#/$defs/clock_bundle"
            },
            "context": {
              "$ref": "#/$defs/context"
            },
            "policy": {
              "$ref": "#/$defs/context"
            }
          },
          "required": [
            "anchor",
            "clock"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "operation",
        "input"
      ],
      "additionalProperties": false
    },
    "effectivePolicy": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "aeonic.operations.temporal.civil-anchor.v1"
        }
      },
      "required": [
        "profile"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "evaluation": {
          "const": "exact-for-policy"
        },
        "clamping": {
          "const": "not-applied"
        },
        "effectivePolicy": {
          "$ref": "#/$defs/effectivePolicy"
        }
      },
      "required": [
        "evaluation",
        "clamping",
        "effectivePolicy"
      ],
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "value"
        },
        "value": {
          "$ref": "#/$defs/datetime_derivedBundle"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        }
      },
      "required": [
        "outcome",
        "value",
        "metadata"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "diagnostic"
        },
        "reason": {
          "enum": [
            "invalid_operand",
            "unsupported_operation",
            "invalid_policy",
            "unsupported_profile",
            "unsupported_domain",
            "incompatible_operand",
            "unrepresentable_result",
            "resource_limit"
          ]
        },
        "context": {
          "type": "object",
          "properties": {
            "stage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "path": {
              "oneOf": [
                {
                  "allOf": [
                    {
                      "type": "string",
                      "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$(?![\\s\\S])"
                    },
                    {
                      "type": "string",
                      "pattern": "^(?:/(?:[^~/]|~[01])*)*$(?![\\s\\S])"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "stage",
            "path"
          ],
          "additionalProperties": false
        },
        "message": {
          "type": "string",
          "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$(?![\\s\\S])"
        }
      },
      "required": [
        "outcome",
        "reason",
        "context"
      ],
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "$ref": "#/$defs/success"
        },
        {
          "$ref": "#/$defs/diagnostic"
        }
      ]
    },
    "resourceLimits": {
      "type": "object",
      "properties": {
        "maxRequestBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxRequestDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxTemporalCharacters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxInputRanges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxInputPieces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxRelativeDayDigits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxFractionDigits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxWork": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxIntermediatePieces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputPieces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxResultBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
