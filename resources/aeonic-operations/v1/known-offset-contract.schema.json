    "resourceLimits": {
      "type": "object",
      "properties": {
        "maxRequestBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxRequestDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxTemporalCharacters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxInputPieces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxIntermediatePieces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputPieces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxWork": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
