        "coefficient": {
          "type": "string",
          "pattern": "^(?:0|-?[1-9](?:[0-9]*[1-9])?)$(?![\\s\\S])"
        },
        "exponent": {
          "type": "string",
          "pattern": "^(?:0|-?[1-9][0-9]*)$(?![\\s\\S])"
        }
