{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeonic-operations:temporal:civil-datetime:contract:v1:working",
  "title": "Aeonic unqualified civil date-time working contract",
  "description": "Closed successful requests and all results; intrinsic date validity, canonical exact sets, resource admission and deterministic diagnostics additionally require the normative source.",
  "$ref": "#/$defs/request",
  "$defs": {
    "coordinate": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]*[1-9])?$(?![\\s\\S])"
    },
    "endBoundary": {
      "type": "object",
      "properties": {
        "boundary": {
          "const": "endOfDomain"
        }
      },
      "required": [
        "boundary"
      ],
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "point"
        },
        "at": {
          "$ref": "#/$defs/coordinate"
        }
      },
      "required": [
        "kind",
        "at"
      ],
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "interval"
        },
        "start": {
          "$ref": "#/$defs/coordinate"
        },
        "end": {
          "oneOf": [
            {
              "$ref": "#/$defs/coordinate"
            },
            {
              "$ref": "#/$defs/endBoundary"
            }
          ]
        },
        "includeStart": {
          "type": "boolean"
        },
        "includeEnd": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "start",
        "end",
        "includeStart",
        "includeEnd"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "end": {
                "type": "object"
              }
            },
            "required": [
              "end"
            ]
          },
          "then": {
            "properties": {
              "includeEnd": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "piece": {
      "oneOf": [
        {
          "$ref": "#/$defs/point"
        },
        {
          "$ref": "#/$defs/interval"
        }
      ]
    },
    "civilDateTime": {
      "type": "object",
      "properties": {
        "category": {
          "const": "civilDateTime"
        },
        "value": {
          "type": "string",
          "pattern": "^(?!0000)[0-9]{4}(?:-|-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12][0-9]|3[01]))?)T(?:[01][0-9]|2[0-3])(?::[0-5][0-9](?::[0-5][0-9](?:\\.[0-9]+)?)?)?$(?![\\s\\S])"
        }
      },
      "required": [
        "category",
        "value"
      ],
      "additionalProperties": false
    },
    "civilDateTimeSet": {
      "type": "object",
      "properties": {
        "category": {
          "const": "civilDateTimeSet"
        },
        "pieces": {
          "type": "array",
          "minItems": 1,
