          "minLength": 1
        },
        "granularity": {
          "enum": [
            "day",
            "month",
            "year"
          ]
        },
        "count": {
          "type": "string",
          "pattern": "^(?:0|-?[1-9][0-9]*)$(?![\\s\\S])"
        }
